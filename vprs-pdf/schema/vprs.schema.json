{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blueprint.ai/schema/vprs.schema.json",
  "title": "Vendor Production Requirement Specification",
  "description": "The data contract between Blueprint AI's hydration step and the document renderer. Section omission is driven by absence: a section with no data here is not printed, and no placeholder is emitted.",
  "type": "object",
  "required": [
    "meta"
  ],
  "additionalProperties": true,
  "definitions": {
    "priority": {
      "type": "string",
      "enum": [
        "Must",
        "Should",
        "Could"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "reqId": {
      "type": "string",
      "pattern": "^(FR|BR|EX|AI|SEC|CTL|AC|OUT|DOC|VD|DEP|AS|DP|OQ|P|INT|PR)-[0-9]{2,3}$",
      "description": "Typed identifier. The prefix classifies the item and must not be reused across categories."
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "projectId",
        "title",
        "solutionType",
        "version",
        "businessUnit"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "catalogRef": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "solutionType": {
          "type": "string",
          "enum": [
            "Accounting / Finance Automation",
            "AI / Agentic AI",
            "RPA Bot",
            "Application / Dashboard",
            "Integration / API"
          ],
          "description": "Drives conditional section hydration. Section 9 (AI / Automation Requirements) renders only for 'AI / Agentic AI' and 'RPA Bot'."
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "businessUnit": {
          "type": "string"
        },
        "processOwner": {
          "type": "string"
        },
        "technicalOwner": {
          "type": "string"
        },
        "preparedBy": {
          "type": "string"
        },
        "issueDate": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "readinessScore": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "id",
            "en"
          ],
          "description": "Document language. Drives renderer-owned strings (section titles, table headers, Given-When-Then keywords) via src/locales.js. Spec content itself must already be written in this language. Defaults to 'id'."
        },
        "organisation": {
          "type": "string",
          "description": "Issuing organisation. Used as the cover wordmark when no logo image is available."
        },
        "logoPath": {
          "type": "string",
          "description": "Path to the brand mark embedded on the cover and in the running page header. Overridden by the CLI --logo flag. Falls back to src/theme/logo.png."
        }
      }
    },
    "overview": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currentState": {
          "type": "string"
        },
        "targetState": {
          "type": "string"
        },
        "volumetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "value"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "solution": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "autonomyLevel": {
          "type": "string"
        },
        "agentPattern": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "responsibility"
            ],
            "properties": {
              "component": {
                "type": "string"
              },
              "responsibility": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "inScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "narrative": {
          "type": "string"
        },
        "mermaid": {
          "type": "string",
          "description": "Mermaid source. Rendered offline by the PDF stage; no CDN is used."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "actor",
              "step"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/reqId"
              },
              "actor": {
                "type": "string"
              },
              "step": {
                "type": "string"
              },
              "output": {
                "type": "string"
              }
            }
          }
        },
        "figureCaption": {
          "type": "string",
          "description": "Caption printed beneath the process diagram."
        }
      }
    },
    "systems": {
      "type": "object",
      "properties": {
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "system",
              "protocol",
              "direction"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/reqId"
              },
              "system": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "protocol": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "frequency": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "aiPrompts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "functional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "priority",
              "requirement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^FR-[0-9]{3}$"
              },
              "priority": {
                "$ref": "#/definitions/priority"
              },
              "requirement": {
                "type": "string"
              }
            }
          }
        },
        "business": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "priority",
              "rule"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^BR-[0-9]{3}$"
              },
              "priority": {
                "$ref": "#/definitions/priority"
              },
              "rule": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "description": "Conditional. Hydrated only for AI / Agentic AI and RPA Bot solution types.",
      "properties": {
        "guardrails": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "priority",
              "control"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AI-[0-9]{3}$"
              },
              "priority": {
                "$ref": "#/definitions/priority"
              },
              "control": {
                "type": "string"
              }
            }
          }
        },
        "humanApprovals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evaluation": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "exceptions": {
      "type": "object",
      "properties": {
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "condition",
              "severity",
              "handling"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^EX-[0-9]{3}$"
              },
              "condition": {
                "type": "string"
              },
              "severity": {
                "$ref": "#/definitions/severity"
              },
              "handling": {
                "type": "string"
              }
            }
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "testing": {
      "type": "array",
      "description": "Given-When-Then acceptance criteria. Every Must-priority requirement should be referenced by at least one criterion.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}$"
          },
          "requirementRef": {
            "type": "string"
          },
          "given": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "then": {
            "type": "string"
          }
        }
      }
    },
    "deployment": {
      "type": "object"
    },
    "documentation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "support": {
      "type": "object"
    },
    "vendorDeliverables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "roadmap": {
      "type": "array",
      "description": "Phase-by-phase implementation roadmap handed to the vendor. Distinct from `deployment`: roadmap is the build plan, deployment is the cutover.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(FASE|PHASE)-[0-9]{1,2}$"
          },
          "phase": {
            "type": "string",
            "description": "Phase name, e.g. 'Fase 1: Persiapan & Integrasi Sistem'"
          },
          "theme": {
            "type": "string",
            "description": "Short workstream label shown under the phase name"
          },
          "description": {
            "type": "string"
          },
          "systems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Systems touched, rendered as chips"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Action items, rendered as an unticked checklist"
          }
        }
      }
    }
  }
}
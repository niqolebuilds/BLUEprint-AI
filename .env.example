# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL_FAST and GEMINI_MODEL_REASONING: Optional model overrides for fast/reasoning tiers.
GEMINI_MODEL_FAST="gemini-3.6-flash"
GEMINI_MODEL_REASONING="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APPS_SCRIPT_URL: the deployed Apps Script web app's /exec URL
# (apps-script/Code.gs). Optional — when unset, the app runs fully local
# (Onboarding/LockScreen, localStorage only), exactly as before. When set,
# login switches to real Sheet-backed accounts (RemoteLogin) and newly
# captured processes are best-effort synced to the Sheet for directorate
# roll-up visibility. Must be a VITE_-prefixed var to be exposed to the
# browser bundle — set it in Vercel's Project Settings > Environment Variables.
VITE_APPS_SCRIPT_URL=""

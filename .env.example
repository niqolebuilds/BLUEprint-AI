# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL_FAST and GEMINI_MODEL_REASONING: Optional model overrides for fast/reasoning tiers.
GEMINI_MODEL_FAST="gemini-3.6-flash"
GEMINI_MODEL_REASONING="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string for the remote backend (api/blueprint.ts).
# When you add Neon via Vercel's Storage tab and connect it to this project,
# Vercel injects this automatically — you don't set it by hand there. For local
# dev, copy it from Neon's dashboard (Connect > Neon serverless driver) into .env.local.
DATABASE_URL=""

# AUTH_TOKEN_SECRET: signs session tokens issued on login (api/_lib/auth.ts).
# Generate a random value yourself, e.g. `openssl rand -hex 32`, and set it in
# both Vercel's Project Settings > Environment Variables and your local .env.local.
# Never reuse this across environments; rotating it invalidates all sessions.
AUTH_TOKEN_SECRET=""

# VITE_ENABLE_REMOTE_AUTH: set to "true" to switch the app from local-only mode
# (Onboarding/LockScreen, localStorage) to the Postgres-backed RemoteLogin flow.
# Must be a VITE_-prefixed var to be exposed to the browser bundle — set it in
# Vercel's Project Settings > Environment Variables, not just .env.local.
VITE_ENABLE_REMOTE_AUTH=""
